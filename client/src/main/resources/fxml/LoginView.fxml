<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.codecollab.client.ui.auth.LoginController"
           styleClass="root">

    <VBox alignment="CENTER" spacing="0" maxWidth="420" maxHeight="500"
          styleClass="login-box" StackPane.alignment="CENTER">

        <Label text="CodeCollab" styleClass="login-title" />
        <Label text="Sign in to your account" styleClass="label-muted"
               style="-fx-padding: 4 0 24 0;" />

        <Label text="Username" styleClass="form-label" />
        <TextField fx:id="usernameField" promptText="Enter your username"
                   styleClass="text-field" maxWidth="Infinity" />

        <Label text="Password" styleClass="form-label" style="-fx-padding: 12 0 0 0;" />
        <PasswordField fx:id="passwordField" promptText="Enter your password"
                       styleClass="password-field" maxWidth="Infinity" />

        <Label fx:id="statusLabel" text="" styleClass="label-error"
               style="-fx-padding: 8 0 0 0;" wrapText="true" maxWidth="Infinity" />

        <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin"
                styleClass="btn-primary" maxWidth="Infinity"
                style="-fx-padding: 10 0; -fx-margin: 16 0 0 0;" />

        <Separator style="-fx-padding: 12 0;" />

        <HBox alignment="CENTER" spacing="6">
            <Label text="Don't have an account?" styleClass="label-muted" />
            <Hyperlink text="Register" onAction="#goToRegister" styleClass="link" />
        </HBox>

        <VBox.margin>
            <Insets top="20" right="20" bottom="20" left="20" />
        </VBox.margin>
    </VBox>
</StackPane>
