<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codecollab.client.ui.snippet.SnippetEditorController"
      spacing="14" style="-fx-padding: 20;">

    <Label fx:id="headingLabel" text="New Snippet" styleClass="label-title" />

    <Label text="Title *" styleClass="form-label" />
    <TextField fx:id="titleField" promptText="Snippet title" styleClass="text-field" />

    <Label text="Description" styleClass="form-label" />
    <TextArea fx:id="descField" promptText="What does this snippet do?" prefRowCount="3"
              styleClass="text-area" />

    <HBox spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Language" styleClass="form-label" />
            <ComboBox fx:id="languageBox" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Tags (comma-separated)" styleClass="form-label" />
            <TextField fx:id="tagsField" promptText="java, sorting, recursion"
                       styleClass="text-field" maxWidth="Infinity" />
        </VBox>
    </HBox>

    <Label text="Code *" styleClass="form-label" />
    <TextArea fx:id="codeArea" prefRowCount="18"
              style="-fx-font-family: 'Consolas','Courier New',monospace; -fx-font-size: 13;"
              styleClass="code-editor" VBox.vgrow="ALWAYS" />

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Cancel" onAction="#handleCancel"
                styleClass="btn-secondary" />
        <Button fx:id="saveBtn" text="Save Snippet" onAction="#handleSave"
                styleClass="btn-primary" />
    </HBox>
</VBox>
