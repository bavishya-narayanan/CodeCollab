<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.codecollab.client.ui.snippet.SnippetListController"
      styleClass="content-area" spacing="12">

    <!-- Header row -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label fx:id="headingLabel" text="Browse Snippets" styleClass="label-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="newSnippetBtn" text="+ New Snippet"
                onAction="#handleNewSnippet" styleClass="btn-primary" />
    </HBox>

    <!-- Search bar (hidden in ALL/MY mode) -->
    <HBox fx:id="searchBar" spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search snippets…"
                   styleClass="text-field" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="languageBox" promptText="Language" prefWidth="140" />
        <Button text="Search" onAction="#handleSearch" styleClass="btn-primary" />
    </HBox>

    <!-- Snippet list -->
    <ListView fx:id="snippetList" VBox.vgrow="ALWAYS" styleClass="list-view" />

    <!-- Pagination -->
    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="prevBtn" text="◀ Prev" onAction="#prevPage" styleClass="btn-secondary" />
        <Label fx:id="pageLabel" text="1 / 1" />
        <Button fx:id="nextBtn" text="Next ▶" onAction="#nextPage" styleClass="btn-secondary" />
    </HBox>

    <VBox.margin>
        <Insets top="0" />
    </VBox.margin>
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>
</VBox>
